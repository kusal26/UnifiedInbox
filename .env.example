POSTGRES_PASSWORD=local_only_password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
